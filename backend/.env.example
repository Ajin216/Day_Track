# ==============================================================================
# DayTrack Backend - Environment Variables Configuration
# Copy this file to .env and replace placeholders with your actual values.
# NEVER commit your real .env file or production secrets to Git!
# ==============================================================================

# Server Environment: 'development', 'production', or 'test'
NODE_ENV=production

# Server Port: Port for Express HTTP server to listen on (default: 5000)
PORT=5000

# MongoDB Database Connection String:
# For production (MongoDB Atlas):
#   mongodb+srv://<username>:<password>@<cluster>.mongodb.net/daytrack?retryWrites=true&w=majority
# For local development:
#   mongodb://localhost:27017/daytrack
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/daytrack?retryWrites=true&w=majority

# JWT Authentication Secret:
# Cryptographically strong secret key used to sign and verify JSON Web Tokens.
# IN PRODUCTION: Must be at least 32 characters long.
# Generate with: openssl rand -hex 32
JWT_SECRET=your_production_jwt_secret_min_32_characters_random_string

# JWT Token Lifespan: e.g., '7d', '24h', '30d' (default: 7d)
JWT_EXPIRES_IN=7d

# Frontend Client URL(s):
# Explicitly approved origin(s) permitted by CORS and CSRF protection policies.
# For multiple domains, separate by comma: https://daytrack.app,https://admin.daytrack.app
CLIENT_URL=https://daytrack.app

# Trust Reverse Proxy:
# Set to '1' or 'true' when deployed behind reverse proxies or load balancers
# (e.g., Render, Railway, Heroku, AWS ALB, Cloudflare, Nginx) to correctly detect HTTPS and client IPs.
TRUST_PROXY=1

# Cookie Security Settings:
# COOKIE_SECURE: Set to 'true' in production (requires HTTPS), 'false' only for local HTTP testing
COOKIE_SECURE=true

# COOKIE_SAMESITE:
# - 'none': Required when frontend and backend are hosted on different domains (e.g. Vercel + Render).
#           MUST be paired with COOKIE_SECURE=true.
# - 'lax': Recommended when frontend and backend share the same site or custom domain.
# - 'strict': Strict isolation, cookies only sent in first-party context.
COOKIE_SAMESITE=none

# COOKIE_DOMAIN (Optional):
# Specify parent domain if frontend and backend share subdomains (e.g., '.daytrack.app')
# COOKIE_DOMAIN=.daytrack.app

# Google OAuth 2.0 Client ID:
# Obtained from Google Cloud Console (APIs & Services > Credentials > OAuth 2.0 Client IDs).
# Used by backend to verify Google Identity Services ID tokens.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
