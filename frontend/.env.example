# ==============================================================================
# DayTrack Frontend - Environment Variables Configuration
# Copy this file to .env and configure the backend API endpoint URL.
# Note: Vite only exposes variables prefixed with VITE_ to the client browser.
# NEVER store secrets, database passwords, or JWT secrets in this file!
# ==============================================================================

# Backend API Base URL:
# For production (e.g. deployed backend URL):
#   https://api.daytrack.app/api
# Or if hosted behind a single-domain reverse proxy:
#   /api
# For local development:
#   http://localhost:5000/api
VITE_API_URL=https://api.daytrack.app/api

# Google OAuth 2.0 Client ID:
# Obtained from Google Cloud Console. Used by Google Identity Services in the browser.
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
